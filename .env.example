# Environment aplikasi: development | production
APP_ENV=development

# Port HTTP server (8090 agar tidak bentrok dengan layanan lain di 8080)
APP_PORT=8090

# Koneksi PostgreSQL (format URL pgx)
DATABASE_URL=postgres://postgres:password@localhost:5432/penggajian?sslmode=disable

# Secret JWT — WAJIB diganti di production (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Umur token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
