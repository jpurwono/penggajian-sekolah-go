# ── Server API Environment ──
# Copy ke .env lalu sesuaikan

# PostgreSQL (external — sudah ada di server)
# Di LXC host:      postgres://user:pass@host.docker.internal:5432/penggajian?sslmode=disable
# Di Docker lain:   postgres://user:pass@<container-name>:5432/penggajian?sslmode=disable
# Di IP tertentu:  postgres://user:pass@192.168.1.50:5432/penggajian?sslmode=disable
DATABASE_URL=postgres://user:password@host.docker.internal:5432/penggajian?sslmode=disable

# JWT Secret — WAJIB ganti (minimal 32 karakter)
# Generate: openssl rand -hex 32
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Token TTL
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
